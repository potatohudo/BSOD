[sub_resource type="GDScript" id="GDScript_8catc"]
resource_name = "sword"
script/source = "
extends RigidBody3D

@export var target: Node3D
const STRENGTH = 100.0
@onready var strength: float = STRENGTH
@export var active = true

func _integrate_forces(state: PhysicsDirectBodyState3D) -> void:
	if not active:
		return

	var pos_error = target.global_position - state.transform.origin
	state.linear_velocity += pos_error * strength * state.step

	var target_rot = target.global_basis.get_rotation_quaternion()
	var current_rot = state.transform.basis.get_rotation_quaternion()

	var rot_error = target_rot * current_rot.inverse()

	if rot_error.w < 0.0:
		rot_error = Quaternion(
			-rot_error.x,
			-rot_error.y,
			-rot_error.z,
			-rot_error.w
		)

	state.angular_velocity += (
		rot_error.get_axis()
		* rot_error.get_angle()
		* strength
		* state.step
	)
func launch(camera):
	var dir = -camera.global_basis.z
	apply_central_impulse(dir)
func attack():
	pass
"

