[sub_resource type="GDScript" id="GDScript_mm71k"]
resource_name = "frutiger_aero"
script/source = "extends Node3D

@onready var timer: Timer = $Timer
@onready var mood_music: AudioStreamPlayer = $MoodMusic

@export var hill: Node3D
@export var markers: Array[Marker3D] = []

@export var area_radius: float = 150.0
@export var spacing: float = 30.0

var rng := RandomNumberGenerator.new()


func _ready() -> void:
	rng.randomize()

	if spacing <= 0.0:
		push_error(\"Spacing must be greater than zero.\")
		return

	for marker in markers:
		if not is_instance_valid(marker):
			continue

		spawn_hills_around(marker)


func spawn_hills_around(marker: Marker3D) -> void:
	var center: Vector3 = marker.global_position
	var steps: int = int(ceil(area_radius / spacing))
	var parent: Node = hill.get_parent()

	for x in range(-steps, steps + 1):
		for z in range(-steps, steps + 1):

			# Randomize the spacing and scale.
			var random_spacing: float = spacing * rng.randf_range(0.6, 1.4)

			var offset := Vector3(
				x * random_spacing,
				0.0,
				z * random_spacing
			)

			# Keep spawned hills within the circular radius.
			if offset.length() > area_radius:
				continue

			# Don't spawn a hill at the center.
			if x == 0 and z == 0:
				continue

			var copy := hill.duplicate() as Node3D

			if copy == null:
				continue

			parent.add_child(copy)

			copy.scale *= random_spacing / 28.0
			copy.global_position = center + offset


func _on_timer_timeout() -> void:
	mood_music.pitch_scale = rng.randf_range(0.3, 0.6)

	await get_tree().create_timer(
		rng.randf_range(0.1, 0.5)
	).timeout

	mood_music.pitch_scale = rng.randf_range(0.3, 0.6)
	timer.start(rng.randf_range(0.5, 40.0))

	print(\"timed out\")
"

