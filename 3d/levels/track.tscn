offset_bottom = -0.6000366
text = Array[String](["[emotion=0:neutral] You remind me of something... [emotion=0:happy]Right! Like ferrofluid!  
It is a dark liquid that is attracted to the poles of a magnet. It is a colloidal liquid made of nanoscale ferromagnetic or ferrimagnetic particles suspended inside a carrier fluid (usually an organic solvent or water). Each magnetic particle is thoroughly coated with a surfactant to inhibit clumping.", "[emotion=0:happy]Large ferromagnetic particles can be ripped out of the homogeneous colloidal mixture, forming a separate clump of magnetic dust when exposed to strong magnetic fields. The magnetic attraction of tiny nanoparticles is weak enough that the surfactant's Van der Waals force is sufficient to prevent magnetic clumping or agglomeration. Ferrofluids usually do not retain magnetization in the absence of an externally applied field and thus are often classified as \"superparamagnets\" rather than ferromagnets.", "[emotion=0:neutral] But I'm just rambling at this point...sorry..."])
speaker_name = "ya3"
character_nodes = Array[NodePath]([NodePath("../..")])
return_texts = Array[String](["[emotion=0:happy]Oh, you're back! [emotion=0:sad] Look- I won't bore you again! I swear I can do better... please... Don't leave me like you did last time..."])

[node name="DialogBubble2" parent="ya3/DialogManager" instance=ExtResource("6_0q3lm")]
